        "jsonBody": "={\n  \"model\": \"claude-sonnet-4-5\",\n  \"max_tokens\": 400,\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Analyze this order for fraud risk. Order total: {{ $json.total }}, Customer past orders: {{ $json.PastOrderCount }}, Email: {{ $json.customerEmail }}. Reply ONLY with JSON: {\\\"risk\\\": \\\"low|medium|high\\\", \\\"reason\\\": \\\"...\\\"}\"\n    }\n  ]\n}",
        "options": {}
