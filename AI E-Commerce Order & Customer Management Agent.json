    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.content[0].text;\nlet parsed;\ntry { parsed = JSON.parse(raw); } catch(e) { parsed = { risk: 'low', reason: 'parse_failed' }; }\nreturn [{ json: { ...$input.first().json, fraudRisk: parsed.risk, fraudReason: parsed.reason } }];"
      },
      "id": "b56954a9-de9f-42fe-a86f-f9ee16d88051",
      "name": "Parse Fraud Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1296,
        48
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.fraudRisk }}",
              "rightValue": "high",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
